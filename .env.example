# AutoTimelapse CM4 Agent Configuration

# Cấu hình Camera & MQTT Auth
CAMERA_CODE=CAM-4YZ8X6
MQTT_PASSWORD=o2hs_IojnvqSXlF1b9M-sg
MQTT_BROKER=mqtt.congnghetimelapse.com
MQTT_PORT=1884
SERVER_BASE=https://cloud.congnghetimelapse.com

# Cấu hình Quản lý Nguồn GPIO 16 trên CM4
POWER_GPIO_PIN=16
POWER_ACTIVE_HIGH=true
WARMUP_DELAY_SEC=3.0
ALWAYS_KEEP_POWER=false

# Cấu hình Telemetry
TELEMETRY_INTERVAL=30

# Cấu hình Hàng Đợi Offline (Lưu đệm trong container)
OFFLINE_QUEUE_DIR=/app/offline_queue
OFFLINE_RETRY_INTERVAL=60

# Cấu hình Thư mục Dữ Liệu Persistent Ghi Đĩa trên CM4
# - Chế độ bình thường: ./data (tự động tạo ./data/offline_queue và ./data/portainer_data)
# - Chế độ đóng băng OS (OverlayFS): đổi duy nhất 1 biến thành phân vùng ghi thật /mnt/data
DATA_DIR=/mnt/data
